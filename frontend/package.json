{
  "name": "research-workspace-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser assets for the research-workspace Python package.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/markdown.ts --bundle --format=esm --platform=node --outfile=test/bundle/markdown.mjs --log-level=warning && node test/build-app-bundle.mjs && node --test \"test/markdown.test.mjs\" \"test/app-render.test.mjs\"",
    "test:browser": "node --test \"test/browser.test.mjs\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.3",
    "@lezer/highlight": "^1.2.1",
    "katex": "^0.16.11",
    "pdfjs-dist": "^4.10.38",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
